sensio_framework_extra:
   psr_message:
      enabled: false
sentry:
  dsn: ""
  tracing:
    enabled: false
  options:
    integrations:
      - 'Sentry\Integration\IgnoreErrorsIntegration'
services:
  Sentry\Integration\IgnoreErrorsIntegration:
    arguments:
      $options:
        ignore_exceptions:
          - 'Symfony\Component\HttpKernel\Exception\NotFoundHttpException'